# Copy to .env next to docker-compose.yml. Never commit .env.
# Unraid Docker UI users: follow docs/unraid-setup.md instead of this file.

# Reusable, non-ephemeral Tailscale auth key tagged with tag:nas-mcp.
# Create at https://login.tailscale.com/admin/settings/keys
# Compose: used by the sidecar. Unraid template: passed into the MCP image.
TS_AUTHKEY=tskey-auth-replace-me

# Bearer token for every MCP request. Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# IANA timezone matching the Unraid host (Settings → Date and Time).
TZ=America/Chicago
